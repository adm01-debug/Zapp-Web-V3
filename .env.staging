# ==============================================================================
# AMBIENTE: STAGING
# ==============================================================================
# Copiar para .env.local ao rodar localmente contra staging.
# NÃO commitar com valores reais — use Vercel Dashboard (Preview env).
#
# Instrução Vercel:
#   Configurações → Environment Variables → marcar "Preview" (não Production)
#   Cada variável abaixo deve ter seu valor real na plataforma.
# ==============================================================================

VITE_SUPABASE_URL=https://supabase-staging.atomicabr.com.br
VITE_SUPABASE_ANON_KEY=sua-anon-key-staging
VITE_APP_NAME=ZAPP-WEB [STAGING]
VITE_APP_ENV=staging
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_GMAIL_INTEGRATION=false

EVOLUTION_API_URL=https://evolution-staging.atomicabr.com.br
EVOLUTION_API_KEY=sua-evolution-api-key-staging

VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
VITE_SENTRY_ENVIRONMENT=staging
