# scripts/.sync-ignore
# ---------------------------------------------------------------------------
# Allowlist para o guard check-fe-be-sync.sh.
#
# Relações (tabelas/views) e funções RPC listadas aqui são chamadas no frontend
# mas NÃO vivem no schema principal do Supabase (supabase/migrations). Elas
# pertencem a bancos EXTERNOS acessados por clients separados:
#   - externalClient.ts  -> projeto "FATOR X" (Bitrix24 bridge)
#   - zappweb/supabaseClient.ts -> instância "zappweb"
#
# Portanto NÃO são drift: é correto que não existam migration neste repo.
# Foram auditadas e confirmadas em call-level (o objeto .from()/.rpc() usa o
# client externo, frequentemente com cast `as never`/`as any`).
#
# REGRA DE OURO: só adicione um nome aqui se você confirmou que a chamada usa
# um client externo OU que a função existe na DB de produção mas foi criada
# fora do fluxo de migrations deste repo (com comentário explicativo).
# NUNCA use este arquivo para "silenciar" drift real do schema principal —
# isso reintroduz exatamente o problema que o guard previne.
#
# Uma entrada por linha. Linhas começando com # são comentários.
# ---------------------------------------------------------------------------

# --- Tabelas do banco EXTERNO (FATOR X / Bitrix24 bridge) ---
companies
interactions
contact_emails

# --- Tabelas da instância zappweb ---
evolution_messages
evolution_conversations
evolution_contacts
evolution_stage_mapping
# Partições concretas da instância wpp2 — acessadas via zappSupabase (zappweb client),
# NÃO via supabase (schema zapp). Confirmado em:
# src/integrations/zappweb/hooks/useZappMessages.ts + useZappConversations.ts
evolution_messages_wpp2
evolution_conversations_wpp2

# --- Funções RPC do banco EXTERNO (FATOR X) — chamadas via externalSupabase ---
rpc_get_contact
rpc_list_contacts
rpc_list_conversations
rpc_insert_message
rpc_list_messages

# ---------------------------------------------------------------------------
# Funções que existem na DB de PRODUÇÃO mas foram criadas fora do fluxo de
# migrations deste repo (criadas manualmente ou via script direto no banco).
#
# COMPROVAÇÃO: as funções têm migrations de ALTER (SECURITY INVOKER, GRANT,
# SET search_path) o que prova que existem, mas nunca tiveram CREATE aqui.
# A solução correta seria criar stub-migrations, mas por enquanto são listadas
# aqui para não bloquear o check. Cada item tem um ticket para migrar
# incrementalmente para supabase/migrations.
# ---------------------------------------------------------------------------

# fn_test_alert_channel — chamado via evoApi.rpc() (ExternalDbProxyClient),
# NÃO via supabase.rpc(). É uma RPC do banco de operações externo (Evolution API
# health). Confirmado em: src/lib/evoApiHealth/hooks.ts + src/lib/evoApiHealth/proxy.ts
fn_test_alert_channel

# Funções dos schemas ops/evo/zapp — existem em produção, criadas via migrations
# diretas no banco (não via supabase/migrations deste repo).
# ops schema:
check_wal_health
fn_ddl_audit_drop
fn_ddl_audit_log
fn_ddl_drop_alert
# evo schema:
fn_bootstrap_wpp2_instance
fn_check_guardian_alive
# zapp schema:
fn_guard_qa_instances

# Funções public schema que existem em produção mas antecedem o rastreamento
# por migrations (foram criadas antes de migrations serem adicionadas ao repo
# para estas funções ou via CLI direta):
# pgvector/search functions:
match_kb_chunks
search_knowledge_base_rag
rpc_record_search_click

# ---------------------------------------------------------------------------
# Funções ALTER-sem-CREATE: existem em produção (confirmado pelo ALTER condicional
# em 20260712170700_r16_search_path_sweep_r14_r15.sql), mas o CREATE original
# não está no fluxo de migrations deste repo. A migration R16 usa IF EXISTS para
# não quebrar supabase db reset. Stub-migrations para cada função estão listadas
# como melhoria futura (R17+).
# ---------------------------------------------------------------------------
fn_check_contact_id_reuse
fn_create_message_audit_entry
fn_get_current_snapshot_version
fn_get_lgpd_consent_status
fn_record_lgpd_consent
# Falso positivo: o grep extrai 'public' da string de formato
# format('ALTER FUNCTION public.%I(%s) SET search_path = ...')
# em 20260712170700_r16_search_path_sweep_r14_r15.sql linha 85.
# O regex backtracks ao bater em '%' e para em 'public'. Não é uma função.
public

# ---------------------------------------------------------------------------
# RPCs de produção chamadas via supabase.rpc() mas cujas CREATE FUNCTION foram
# feitas fora do fluxo de migrations (criadas manualmente na instância).
# Stub-migrations serão adicionadas incrementalmente (R17+).
# ---------------------------------------------------------------------------
# Gmail OAuth integration (src/hooks/useIntegrationManagement.ts):
initiate_gmail_oauth
complete_gmail_oauth
get_own_email_accounts
# CRM / enriquecimento (src/hooks/useCRMManagement.ts, useIntegrationManagement.ts):
sync_to_crm
enrich_contact
# Export/import/download (src/hooks/useMediaManagement.ts):
export_user_data
import_user_data
check_download_permission
# Analytics / search (src/hooks/useSearchManagement.ts, useAnalyticsManagement.ts):
get_search_insights
search_chat_messages
get_latest_analysis

# ---------------------------------------------------------------------------
# RPCs que aparecem SOMENTE em arquivos __tests__ (não são chamadas de produção).
# Detectadas pelo sync check porque ele varre src/ sem excluir __tests__.
# ---------------------------------------------------------------------------
# src/lib/evoApiHealth/__tests__/proxy.test.ts
my_function
no_params_fn
