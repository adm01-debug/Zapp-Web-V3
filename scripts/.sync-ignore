# Export/import/download (src/hooks/useMediaManagement.ts):
export_user_data
import_user_data
check_download_permission
# Analytics / search (src/hooks/useSearchManagement.ts, useAnalyticsManagement.ts):
get_search_insights
search_chat_messages
get_latest_analysis

# ---------------------------------------------------------------------------
# RPCs que aparecem SOMENTE em arquivos __tests__ (não são chamadas de produção).
