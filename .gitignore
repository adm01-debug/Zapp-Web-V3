# ============================================
# ZAPP-WEB .gitignore - Segurança Primeiro!
# ============================================

# ====================
# SECRETS E AMBIENTE (CRÍTICO!)
# ====================
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
*.pem
*.key
*.crt
*.p12
secrets/
.secrets
credentials.json
service-account.json
firebase-adminsdk*.json

# Credenciais em texto plano (PT-BR e EN)
*credencia*.txt
*credential*.txt
*cred*.txt
*token*.txt
*apikey*.txt
*api_key*.txt
*senha*.txt
*password*.txt
*secret*.txt
*chave*.txt

# ====================
# LOGS
# ====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ====================
# DEPENDÊNCIAS
# ====================
# AUDITORIA 2026-07-17: era "node_modules/" (com barra), que ignora apenas
# DIRETORIO. Um symlink chamado node_modules e um ARQUIVO -> passava batido no
# git add -A, era commitado, e no runner virava symlink pendurado. bun install
# morria com: ENOENT: could not open the "node_modules" directory (exit 1).
# Sem a barra, ignora diretorio, symlink e arquivo.
node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# ====================
# LOCKFILES
# ====================
# Este projeto usa BUN como gerenciador de pacotes.
# O arquivo canônico é bun.lock (commitado e rastreado).
# package-lock.json é gerado pelo npm e NÃO deve ser commitado
# (diverge do bun.lock e causa installs não-determinísticos em CI).
# Para instalar: bun install
package-lock.json
# bun.lockb é o formato binário do bun v1 (este projeto usa bun v1.3+ texto)
bun.lockb

# ====================
# BUILD E PRODUÇÃO
# ====================
dist/
dist-ssr/
build/
.next/
out/
*.local

# ====================
# CACHE
# ====================
.cache/
.parcel-cache/
.turbo/
.vercel/
.netlify/
.vite/
*.tsbuildinfo

# ====================
# TESTES
# ====================
coverage/
.nyc_output/
test-results/
playwright-report/
playwright-report-a11y/
playwright/.cache/

# ====================
# EDITOR E IDE
# ====================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# ====================
# SISTEMA OPERACIONAL
# ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# ====================
# SUPABASE LOCAL
# ====================
supabase/.branches/
supabase/.temp/
.supabase/

# ====================
# ARQUIVOS GRANDES
# ====================
*.zip
*.tar.gz
*.rar
*.7z

# ====================
# BACKUPS
# ====================
*.bak
*.backup
*_backup*
*_old*
*.orig

# ====================
# OUTROS
# ====================
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache
.stylelintcache
*.tgz
.yarn-integrity

# Playwright auth state
e2e/.auth/
playwright-report-e2e/
.dist-backups/

# ====================
# ARTEFATOS TEMPORÁRIOS DE DEV
# (Não são código de aplicação)
# ====================
# Diretório de trabalho temporário
tmp/

# Saídas de scripts de auditoria ad-hoc
audit.js
audit.mjs
audit.json
full_audit_report.txt

# Rastreamento de deps desatualizadas (muda toda semana, não é fonte da verdade)
outdated.txt

# Scripts de dados mock e saídas SQL grandes
generate_mock_data.py
mock_data.sql

# Saída de build do TypeScript (gerado por `tsc --noEmit 2> ts_errors.txt`)
# Não versionar: muda a cada build, aparece vazio quando clean
ts_errors.txt

# Artefatos de auditoria de design gerados (não são código-fonte)
design-system-audit.html
design-system-audit.md

# Relatórios de CI gerados por check-types-schemas.mjs e scripts similares
reports/
