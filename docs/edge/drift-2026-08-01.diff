+    return new Response(JSON.stringify({ ok: true, cid, rid, data: data || [], count: count ?? (data?.length || 0), schema, table, latency_ms: Date.now() - start }), { status: 200, headers: { ...cors, "Content-Type": "application/json" } });
+  } catch (e) {
