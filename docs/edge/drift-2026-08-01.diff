+      duration_ms: Date.now() - startedAt, error_message: detail.slice(0, 500),
+    });
+    return new Response(
+      JSON.stringify({ success: false, error: 'internal_error', requestId }),
+      { status: 200, headers: corsHeaders },
+    );
+  }
+});
