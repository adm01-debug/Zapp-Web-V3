+const store=new Map();
+export const RATE_LIMITS={standard:{windowMs:60000,maxRequests:30},llm:{windowMs:60000,maxRequests:15},heavy:{windowMs:60000,maxRequests:5},auth:{windowMs:300000,maxRequests:10},webhook:{windowMs:60000,maxRequests:60}};
+export function getRateLimitIdentifier(req,userId){if(userId)return`user:${userId}`;const k=req.headers.get('x-api-key')||req.headers.get('apikey');if(k)return`key:${k.substring(0,16)}`;const f=req.headers.get('x-forwarded-for');return`ip:${f?.split(',')[0]?.trim()||'unknown'}`;}
+export function checkRateLimit(id,config=RATE_LIMITS.standard){const now=Date.now();let e=store.get(id);if(!e){e={ts:[],lc:now};store.set(id,e);}e.ts=e.ts.filter(t=>now-t<config.windowMs);if(e.ts.length>=config.maxRequests){const r=e.ts[0]+config.windowMs;return{allowed:false,remaining:0,resetAt:r,limit:config.maxRequests,retryAfterMs:Math.max(0,r-now)};}e.ts.push(now);return{allowed:true,remaining:config.maxRequests-e.ts.length,resetAt:now+config.windowMs,limit:config.maxRequests,retryAfterMs:0};}
+export function createRateLimitResponse(result,corsHeaders={}){const s=Math.ceil(result.retryAfterMs/1000);return new Response(JSON.stringify({error:'Rate limit exceeded',retryAfterSeconds:s}),{status:429,headers:{...corsHeaders,'Content-Type':'application/json','Retry-After':String(s)}});}
