+  category_id: z.string().uuid().optional(),
+  supplier_id: z.string().uuid().optional(),
+  limit: z.number().int().min(1).max(100).default(50),
+  offset: z.number().int().min(0).default(0),
+  order_by: z.enum(ALLOWED_ORDER_FIELDS).default("name"),
