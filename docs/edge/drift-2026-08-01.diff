+/**
+ * Shared validation, security, and logging utilities for Edge Functions.
+ * Provides input sanitization, rate limiting, structured logging, and standard error responses.
+ */
+
+// Re-export HMAC validation utilities
+export { 
+  verifyHmacSignature, 
