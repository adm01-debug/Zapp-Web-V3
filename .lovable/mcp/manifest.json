{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://supabase.atomicabr.com.br/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "zapp-web-mcp",
      "version": "0.1.0",
      "title": "ZAPP Web MCP"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Quem sou eu",
        "description": "Retorna informa\u00e7\u00f5es do usu\u00e1rio autenticado que est\u00e1 chamando o MCP (ID, e-mail, client ID).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_whatsapp_connections",
        "title": "Listar conex\u00f5es WhatsApp",
        "description": "Lista as conex\u00f5es WhatsApp (inst\u00e2ncias) vis\u00edveis para o usu\u00e1rio autenticado, respeitando RLS.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "M\u00e1ximo de conex\u00f5es a retornar (padr\u00e3o 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_contacts",
        "title": "Buscar contatos",
        "description": "Busca contatos por nome ou telefone (LIKE case-insensitive). Respeita RLS do usu\u00e1rio.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Termo de busca (nome ou telefone)."
            },
            "limit": {
              "description": "M\u00e1ximo de resultados (padr\u00e3o 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      }
    ]
  },
  "_note": "npm package version (Deno edge function uses @0.20.0 \u2014 independent ecosystems)"
}
