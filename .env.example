# =============================================================================
# .env.example — referência completa de variáveis de ambiente do ZAPP Web v3
# -----------------------------------------------------------------------------
# Copie para .env (ou .env.local para dev local):  cp .env.example .env
# NUNCA commite valores reais (`.env*` está no .gitignore).
#
# Documentação gerada por varredura do código (OC-05, 2026-08-07):
#   grep -rhoE 'import\.meta\.env\.[A-Z_0-9]+' src/ | sort -u
#   grep -rhoE 'process\.env\.[A-Z_0-9]+' src/ | sort -u
# Vars marcadas com "(CI)" são injetadas pelo build do GitHub Actions
# (deploy-vps.yml / deploy-vps-selfhosted.yml) — não precisam de .env local.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1) SUPABASE — cliente (Vite, prefixo VITE_ exposto ao bundle público)
# ─────────────────────────────────────────────────────────────────────────────

# URL pública do Supabase self-hosted (produção: https://supabase.atomicabr.com.br).
# Usada pelo client Supabase (src/integrations/supabase/*). (CI)
VITE_SUPABASE_URL=

# Anon key do Supabase. Em produção o build CI injeta
# VITE_SUPABASE_PUBLISHABLE_KEY como valor desta var (deploy-vps.yml). (CI)
VITE_SUPABASE_ANON_KEY=

# Alias legado de VITE_SUPABASE_ANON_KEY (src/lib/env.ts usa como fallback).
VITE_ANON_KEY=

# Alias legado de VITE_SUPABASE_URL (src/lib/env.ts usa como fallback).
VITE_SUPABASE_PUBLIC_URL=

# Publishable key — usada no client (ex.: voz/ElevenLabs, src/components/voice/)
# e server-side (MCP tools). (CI)
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL canônica da "conexão externa" em produção (fallback:
# https://supabase.atomicabr.com.br) — src/hooks/useConnections.ts.
VITE_EXTERNAL_SUPABASE_URL=

# Anon key da conexão externa em produção (sem fallback no código).
VITE_EXTERNAL_SUPABASE_ANON_KEY=

# Conexão externa em DEV (fallback: https://supabase-dev.atomicabr.com.br).
# Usada quando VITE_APP_ENV=development. (REC-03-13: fallback mantido de propósito)
VITE_DEV_EXTERNAL_SUPABASE_URL=

# Anon key da conexão externa em DEV (sem fallback no código).
VITE_DEV_EXTERNAL_SUPABASE_ANON_KEY=

# Conexão externa em STAGING (fallback: https://supabase-staging.atomicabr.com.br).
# Usada quando VITE_APP_ENV=staging. (REC-03-13: fallback mantido de propósito)
VITE_STAGING_EXTERNAL_SUPABASE_URL=

# Anon key da conexão externa em STAGING (sem fallback no código).
VITE_STAGING_EXTERNAL_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2) EVOLUTION API (WhatsApp) — cliente
# ─────────────────────────────────────────────────────────────────────────────

# URL da Evolution API (fallback: https://evolution.atomicabr.com.br).
# DEPRECATED V3 (2026-08-14): Evolution API URL não é mais acessada diretamente do browser.
# Use a edge fn evolution-proxy (docs/decouple/RUNBOOK_TROCA_PROVIDER.md).
# VITE_EVOLUTION_API_URL=

# OVERRIDE opcional de emergência da API key (rotação manual fora de banda).
# Quando ausente (padrão em produção), a key é obtida em runtime via edge fn
# `evolution-credentials` (JWT-gated) — o secret NUNCA é embutido no bundle.
# DEPRECATED V3: API Key nunca deve chegar ao browser. Gerenciada via evolution-credentials edge fn.
# VITE_EVOLUTION_API_KEY=

# Nome da instância Evolution default (fallback: 'wpp2').
VITE_ZAPPWEB_INSTANCE=

# ─────────────────────────────────────────────────────────────────────────────
# 3) APP — runtime/build (CI)
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente: development | staging | production (default: production).
# Controla os fallbacks de conexão externa (seção 1).
VITE_APP_ENV=

# Versão da release (Sentry release; fallback: VITE_VERSION). (CI)
VITE_APP_VERSION=

# Alias legado de versão (src/lib/env.ts usa como fallback).
VITE_VERSION=

# Commit SHA do build (Sentry release fallback). (CI: github.sha)
VITE_GIT_SHA=

# URL pública canônica do app (fallback: window.location.origin).
VITE_PUBLISHED_URL=

# Polling interval em ms para fetchers de filas (mín. 3000; default 15000).
VITE_POLL_INTERVAL=

# Tempo em ms antes de limpar automaticamente o indicador de digitação do contato
# (padrão: 5000ms). Consumido por useContactTyping.ts como TYPING_AUTO_CLEAR_MS.
VITE_TYPING_AUTO_CLEAR_MS=

# Debounce em ms para o evento "parou de digitar" do contato (padrão: 600ms).
# Consumido por useContactTyping.ts como TYPING_STOP_DEBOUNCE_MS.
VITE_TYPING_STOP_DEBOUNCE_MS=

# Habilita observabilidade client (web-vitals) quando exatamente 'true'.
VITE_ENABLE_CLIENT_OBSERVABILITY=

# Sentry DSN — vazio/ausente = Sentry desativado (noop, zero overhead). (CI)
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# 4) SERVER-SIDE (process.env — MCP tools, runtimes, scripts)
# ─────────────────────────────────────────────────────────────────────────────

# URL do Supabase para ferramentas MCP server-side (src/lib/mcp/tools/*).
SUPABASE_URL=

# Anon key server-side (fallback do publishable nas MCP tools).
SUPABASE_ANON_KEY=

# Publishable key server-side (usada antes do anon nas MCP tools).
SUPABASE_PUBLISHABLE_KEY=

# Ambiente Node (development/production/test) — builtin do runtime.
NODE_ENV=

# ─────────────────────────────────────────────────────────────────────────────
# 5) E2E (Playwright — src/tests/e2e/*.spec.ts)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL local para specs de métricas/SW (default: http://localhost:8080).
E2E_LOCALHOST_URL=

# URL de preview (fallback legado: https://zapp-web-v3.vercel.app/).
E2E_PREVIEW_URL=

# URL publicada (fallback legado: https://zapp-web-v3.vercel.app/).
E2E_PUBLISHED_URL=

# =1 força falha (em vez de skip gracioso) quando localhost indisponível:
E2E_STRICT_AUTH_LOOP=
E2E_STRICT_METRICS=
E2E_STRICT_SW=
E2E_STRICT_WB_CACHE=
E2E_STRICT_WORKBOX=

# =1 habilita suíte e2e de inbox (gated, ex.: RUN_INBOX_E2E=1 npx playwright test).
RUN_INBOX_E2E=

# CI=true quando rodando em GitHub Actions (builtin).
CI=

# ─────────────────────────────────────────────────────────────────────────────
# 6) GERAÇÃO DE TYPES (self-hosted) — scripts/gen-types-zapp.mjs
#    e scripts/validate-supabase-types.sh
# ─────────────────────────────────────────────────────────────────────────────

# URL do postgres-meta da VPS AtomicaBR (Kong key-auth).
# ⚠️ O endpoint antigo supabase-meta.atomicabr.com.br está FORA DO AR (2026-07-31);
#    use o caminho /pg do Kong, que é o default do scripts/gen-types-zapp.mjs.
META_URL=https://supabase.atomicabr.com.br/pg

# Bearer/API key do postgres-meta (Kong key-auth: header `apikey`).
# Fonte: GitHub Secrets do repo — `ZAPP_META_TOKEN` (workflow ci.yml).
# Obter em: Settings → Secrets and variables → Actions → ZAPP_META_TOKEN
META_TOKEN=

# Schemas incluídos na geração (opcional; default: public,zapp,evo)
# SCHEMAS=public,zapp,evo

# Arquivo de saída (opcional; default: src/integrations/supabase/types.ts)
# OUT_FILE=src/integrations/supabase/types.ts

# Alternativa Cloud (validate-supabase-types.sh): projeto + token do Supabase CLI.
# SUPABASE_PROJECT_ID=
# SUPABASE_ACCESS_TOKEN=

# E36 — Fonte de mensagens do inbox (dual-path zapp×evo, docs/adr/dual-path-inbox.md)
#   evo  = cursor-based (rpc_list_messages_lite, Evolution DB) — forçado
#   zapp = legado (zapp.messages) — forçado
#   auto = default: evo quando disponível; fallback automático telemetrado (source_fallback)
# VITE_INBOX_SOURCE_MODE=auto
