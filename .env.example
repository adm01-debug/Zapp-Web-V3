# ═══════════════════════════════════════════════════════════════
# FATOR X v6.1 — NOTA DE ARQUITETURA (single-database)
# O dominio evolution_* vive no MESMO Supabase self-hosted do client
# principal (VITE_SUPABASE_URL=https://supabase.atomicabr.com.br).
# As variaveis VITE_EXTERNAL_* abaixo sao OPCIONAIS/LEGADO: quando
# ausentes, o app reutiliza o client principal AUTENTICADO (correto).
# NAO aponte VITE_EXTERNAL_* para o Supabase Cloud FATOR X antigo.
# ═══════════════════════════════════════════════════════════════

# ==============================================================================
# ZAPP-WEB - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env.local e preencha com os valores reais
# NUNCA commitar o arquivo .env com valores reais!

# ==============================================================================
# SUPABASE (OBRIGATÓRIO)
# ==============================================================================
# Self-hosted oficial. A anon key é PÚBLICA (vai no bundle do browser):
# pegue o valor de ANON_KEY no .env/compose do VPS (supabase.atomicabr.com.br).
VITE_SUPABASE_URL=https://supabase.atomicabr.com.br
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ------------------------------------------------------------------------------
# EXTERNAL (LEGADO / OPCIONAL) — Contact 360° enrichment
# Pos-consolidacao single-database, deixe COMENTADO: o app reutiliza o client
# principal autenticado. Se um dia precisar de banco separado, aponte para o
# self-hosted — NUNCA para o Supabase Cloud FATOR X antigo (desativado).
# VITE_EXTERNAL_SUPABASE_URL=https://supabase.atomicabr.com.br
# VITE_EXTERNAL_SUPABASE_ANON_KEY=anon-key-do-self-hosted

# ==============================================================================
# EVOLUTION API - WHATSAPP (OBRIGATÓRIO para Edge Functions)
# ==============================================================================
EVOLUTION_API_URL=https://evolution.atomicabr.com.br
EVOLUTION_API_KEY=sua-evolution-api-key

# ==============================================================================
# SENTRY - OBSERVABILIDADE (RECOMENDADO)
# ==============================================================================
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
VITE_SENTRY_ENVIRONMENT=development

# ==============================================================================
# GMAIL INTEGRATION - OAUTH2 (OPCIONAL)
# ==============================================================================
GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxx
GMAIL_REDIRECT_URI=https://supabase.atomicabr.com.br/functions/v1/gmail-oauth

# ==============================================================================
# AI PROVIDERS - CHATBOTS (OPCIONAL)
# ==============================================================================
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk_xxx

# ==============================================================================
# APP CONFIG
# ==============================================================================
VITE_APP_NAME=ZAPP-WEB
VITE_APP_ENV=development

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_GMAIL_INTEGRATION=false
# Habilita auto-provisionamento no servidor externo (ExternalSessionBridge).
# Quando false (padrão), usuários sem conta no externo recebem aviso visível
# em vez de tentativa silenciosa de criação de conta.
# VITE_EXTERNAL_SESSION_BRIDGE_AUTO_PROVISION=false

# ==============================================================================
# BITRIX24 (OPCIONAL - se integrado)
# ==============================================================================
# VITE_BITRIX_WEBHOOK_URL=https://promobrindes.bitrix24.com.br/rest/1/xxx/

# ==============================================================================
# STORAGE R2 (OPCIONAL)
# ==============================================================================
# R2_ACCOUNT_ID=xxx
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_BUCKET_NAME=zapp-media

# ==============================================================================
# MCP (Claude Code / .mcp.json) — servidores locais de desenvolvimento
# ==============================================================================
# Token do MCP self-hosted do Supabase, consumido por .mcp.json via ${VAR}.
# NUNCA versionar o valor real — deixá-lo apenas no ambiente local / secret store.
# SELFHOSTED_SUPABASE_MCP_TOKEN=
